[Unit]
Description=Cloudflare quick tunnel to the NoNonsenseMusic backend (temporary https://*.trycloudflare.com address)
After=network-online.target nononsense.service
Wants=network-online.target

[Service]
# no account and no credentials: a quick tunnel. Its address changes whenever this service restarts
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8000
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
