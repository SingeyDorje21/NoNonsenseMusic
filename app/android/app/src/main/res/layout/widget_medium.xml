<?xml version="1.0" encoding="utf-8"?>
<!-- The widget at 4 x 2: the song, like, and previous / play / next. NowPlayingWidget.kt fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_cover_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_no_cover"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_nothing_played"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:letterSpacing="-0.01"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_muted"
                android:textSize="13sp"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_like"
            android:src="@drawable/widget_heart_outline"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/widget_prev"/>
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <ImageView
                android:id="@+id/play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_play_bg"/>
            <ImageButton
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_play"
                android:src="@drawable/widget_play"/>
        </FrameLayout>
        <ImageButton
            android:id="@+id/next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/widget_next"/>
    </LinearLayout>
</LinearLayout>
