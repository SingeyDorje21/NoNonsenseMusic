<?xml version="1.0" encoding="utf-8"?>
<!-- The widget at 4 x 3 and up: the medium widget, the last three plays and four quick-start playlists. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_cover_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_no_cover"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_nothing_played"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:letterSpacing="-0.01"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_muted"
                android:textSize="13sp"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_like"
            android:src="@drawable/widget_heart_outline"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/widget_prev"/>
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <ImageView
                android:id="@+id/play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_play_bg"/>
            <ImageButton
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_play"
                android:src="@drawable/widget_play"/>
        </FrameLayout>
        <ImageButton
            android:id="@+id/next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/widget_next"/>
    </LinearLayout>
    <TextView
        android:id="@+id/recent_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:text="@string/widget_recent"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:letterSpacing="-0.01"
                android:textStyle="bold"/>
    <LinearLayout
        android:id="@+id/recent0"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/recent0_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/recent0_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/recent1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/recent1_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/recent1_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/recent2"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/recent2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/recent2_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tiles_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:text="@string/widget_tiles"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:letterSpacing="-0.01"
                android:textStyle="bold"/>
    <LinearLayout
        android:id="@+id/tiles_top"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="0dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tile0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_tile_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:letterSpacing="-0.01"
                android:textStyle="bold"/>
        <TextView
            android:id="@+id/tile1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:letterSpacing="-0.01"
                android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tiles_bottom"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tile2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_tile_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:letterSpacing="-0.01"
                android:textStyle="bold"/>
        <TextView
            android:id="@+id/tile3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tile_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:letterSpacing="-0.01"
                android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
